---
// src/components/Header.astro
// HEADER COMPLETO - LOGO ANIMADO DESDE /videos/
---

<header class="main-header">
  <div class="header-container">
    <!-- LOGO + NOMBRE -->
    <div class="logo-section">
      <a href="/" class="logo-link" id="logo-link">
        <div class="logo-wrapper">
          <div class="logo-diafragma">
            <span class="iniciales-rm">RM</span>
            <!-- VIDEO DESDE /videos/ -->
            <video class="video-diafragma" autoplay muted loop playsinline>
              <source src="/videos/logo-diafragma.webm" type="video/webm">
            </video>
          </div>
        </div>
        
        <div class="nombre-container">
          <span class="nombre-fotografo">Rodrigo Montero</span>
          <span class="tagline-fotografo">Fotografía</span>
        </div>
      </a>
    </div>

    <!-- MENÚ -->
    <nav class="main-nav">
      <ul class="nav-list">
        <li><a href="#inicio" class="nav-link active">Inicio</a></li>
        <li><a href="#sobre-mi" class="nav-link">Sobre Mí</a></li>
        <li><a href="#galeria" class="nav-link">Galería</a></li>
        <li><a href="#servicios" class="nav-link">Servicios</a></li>
        <li><a href="#contacto" class="nav-link">Contacto</a></li>
        <li>
          <a href="#acceso-clientes" class="nav-btn-cliente">
            <i class="fas fa-lock"></i> Área Clientes
            <span class="badge-exclusivo">Exclusivo</span>
          </a>
        </li>
      </ul>
      
      <button class="menu-hamburguesa" id="menuToggle">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </nav>
  </div>
</header>

<style>
  /* FUENTES */
  .nombre-fotografo, .iniciales-rm {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
  }
  
  body, .nav-link, .tagline-fotografo, .nav-btn-cliente {
    font-family: 'Inter', -apple-system, sans-serif;
  }
  
  /* HEADER */
  .main-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background-color: rgba(27, 27, 27, 0.95);
    backdrop-filter: blur(10px);
    padding: 1rem 0;
    z-index: 1000;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  
  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  /* LOGO */
  .logo-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
  }
  
  .logo-diafragma {
    position: relative;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    overflow: hidden;
  }
  
  .video-diafragma {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* FILTRO MÁGICO: blanco → violeta */
    filter: brightness(0) saturate(100%) 
            invert(27%) sepia(90%) saturate(2000%) 
            hue-rotate(250deg) brightness(110%) contrast(120%);
  }
  
  .iniciales-rm {
    position: absolute;
    font-size: 22px;
    color: #8A2BE2;
    z-index: 2;
  }
  
  /* NOMBRE */
  .nombre-container {
    display: flex;
    flex-direction: column;
  }
  
  .nombre-fotografo {
    font-size: 24px;
    color: white;
  }
  
  .tagline-fotografo {
    font-size: 11px;
    color: #8A2BE2;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-top: 2px;
  }
  
  /* MENÚ */
  .nav-list {
    display: flex;
    list-style: none;
    gap: 1.5rem;
    align-items: center;
    margin: 0;
    padding: 0;
  }
  
  .nav-link {
    text-decoration: none;
    color: #E0E0E0;
    font-weight: 500;
    padding: 8px 12px;
    border-radius: 4px;
    transition: all 0.3s ease;
  }
  
  .nav-link:hover {
    color: #8A2BE2;
    background-color: rgba(138, 43, 226, 0.1);
  }
  
  .nav-link.active {
    color: #8A2BE2;
    font-weight: 600;
  }
  
  /* BOTÓN CLIENTES */
  .nav-btn-cliente {
    background: linear-gradient(135deg, #8A2BE2, #6a11cb);
    color: white !important;
    padding: 10px 20px !important;
    border-radius: 30px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }
  
  .badge-exclusivo {
    background-color: rgba(255,255,255,0.2);
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 10px;
  }
  
  /* HAMBURGUESA (móvil) */
  .menu-hamburguesa {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    width: 30px;
    height: 24px;
    flex-direction: column;
    justify-content: space-between;
  }
  
  .menu-hamburguesa span {
    display: block;
    width: 100%;
    height: 3px;
    background-color: white;
    border-radius: 3px;
  }
  
  /* RESPONSIVE */
  @media (max-width: 768px) {
    .menu-hamburguesa {
      display: flex;
    }
    
    .nav-list {
      position: fixed;
      top: 80px;
      left: 0;
      width: 100%;
      background-color: #1B1B1B;
      flex-direction: column;
      padding: 2rem;
      transform: translateY(-100%);
      opacity: 0;
      transition: all 0.3s ease;
    }
    
    .nav-list.active {
      transform: translateY(0);
      opacity: 1;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Menú hamburguesa
    const menuToggle = document.getElementById('menuToggle');
    const navList = document.querySelector('.nav-list');
    
    if (menuToggle) {
      menuToggle.addEventListener('click', function() {
        this.classList.toggle('active');
        navList.classList.toggle('active');
      });
    }
    
    // Logo click - volver arriba
    document.getElementById('logo-link').addEventListener('click', function(e) {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });
</script>
