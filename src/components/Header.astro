---
// src/components/Header.astro
// HEADER COMPLETO CON LOGO CANVAS (9 láminas realistas)
---

<header class="main-header">
  <div class="header-container">
    <!-- LOGO + NOMBRE -->
    <div class="logo-section">
      <a href="/" class="logo-link" id="logo-link">
        <div class="logo-wrapper">
          <div class="logo-diafragma">
            <!-- CANVAS DEL DIAFRAGMA -->
            <canvas id="logoCanvas" class="canvas-diafragma" width="60" height="60"></canvas>
            <!-- INICIALES SUPERPUESTAS -->
            <span class="iniciales-rm">RM</span>
          </div>
        </div>
        
        <div class="nombre-container">
          <span class="nombre-fotografo">Rodrigo Montero</span>
          <span class="tagline-fotografo">Fotografía</span>
        </div>
      </a>
    </div>

    <!-- MENÚ -->
    <nav class="main-nav">
      <ul class="nav-list">
        <li><a href="#inicio" class="nav-link active">Inicio</a></li>
        <li><a href="/sobre-mi" class="nav-link">Sobre Mí</a></li>
        <li><a href="#galeria" class="nav-link">Galería</a></li>
        <li><a href="#servicios" class="nav-link">Servicios</a></li>
        <li><a href="#contacto" class="nav-link">Contacto</a></li>
        <li>
          <a href="#acceso-clientes" class="nav-btn-cliente">
            <i class="fas fa-lock"></i> Área Clientes
            <span class="badge-exclusivo">Exclusivo</span>
          </a>
        </li>
      </ul>
      
      <button class="menu-hamburguesa" id="menuToggle">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </nav>
  </div>
</header>

<style>
  /* ===== VARIABLES ===== */
  :root {
    --color-primario: #8A2BE2;
    --color-primario-hover: #9d4edd;
    --color-fondo: #1B1B1B;
    --color-blanco: #FFFFFF;
    --color-texto: #E0E0E0;
    --sombra-suave: 0 4px 20px rgba(0,0,0,0.15);
    --transicion: all 0.3s ease;
  }
  
  /* ===== FUENTES ===== */
  .nombre-fotografo, .iniciales-rm {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
  }
  
  .nav-link, .tagline-fotografo, .nav-btn-cliente {
    font-family: 'Inter', -apple-system, sans-serif;
  }
  
  /* ===== HEADER ===== */
  .main-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background-color: rgba(27, 27, 27, 0.95);
    backdrop-filter: blur(10px);
    padding: 1rem 0;
    z-index: 1000;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    box-shadow: var(--sombra-suave);
  }
  
  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  /* ===== LOGO CANVAS ===== */
  .logo-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    transition: var(--transicion);
  }
  
  .logo-link:hover {
    transform: translateY(-2px);
  }
  
  .logo-diafragma {
    position: relative;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    overflow: hidden;
    background: transparent;
    box-shadow: 0 0 0 1px rgba(138, 43, 226, 0.3);
    transition: var(--transicion);
  }
  
  .logo-link:hover .logo-diafragma {
    box-shadow: 0 0 0 2px var(--color-primario), 0 5px 20px rgba(138, 43, 226, 0.4);
  }
  
  .canvas-diafragma {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 50%;
  }
  
  .iniciales-rm {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 22px;
    color: var(--color-primario);
    z-index: 10;
    text-shadow: 0 0 10px rgba(138, 43, 226, 0.5);
    pointer-events: none;
  }
  
  /* ===== NOMBRE ===== */
  .nombre-container {
    display: flex;
    flex-direction: column;
  }
  
  .nombre-fotografo {
    font-size: 24px;
    color: var(--color-blanco);
    letter-spacing: -0.3px;
  }
  
  .tagline-fotografo {
    font-size: 11px;
    color: var(--color-primario);
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    margin-top: 2px;
  }
  
  /* ===== MENÚ ===== */
  .main-nav {
    display: flex;
    align-items: center;
  }
  
  .nav-list {
    display: flex;
    list-style: none;
    gap: 1.5rem;
    align-items: center;
    margin: 0;
    padding: 0;
  }
  
  .nav-link {
    text-decoration: none;
    color: var(--color-texto);
    font-weight: 500;
    padding: 8px 14px;
    border-radius: 6px;
    transition: var(--transicion);
  }
  
  .nav-link:hover {
    color: var(--color-primario);
    background-color: rgba(138, 43, 226, 0.1);
  }
  
  .nav-link.active {
    color: var(--color-primario);
    font-weight: 600;
  }
  
  /* ===== BOTÓN CLIENTES ===== */
  .nav-btn-cliente {
    background: linear-gradient(135deg, var(--color-primario), #6a11cb);
    color: white !important;
    padding: 10px 22px !important;
    border-radius: 30px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 4px 15px rgba(138, 43, 226, 0.3);
    transition: var(--transicion);
    text-decoration: none;
  }
  
  .nav-btn-cliente:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(138, 43, 226, 0.4);
  }
  
  .badge-exclusivo {
    background-color: rgba(255,255,255,0.2);
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
  }
  
  /* ===== HAMBURGUESA ===== */
  .menu-hamburguesa {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    width: 30px;
    height: 24px;
    flex-direction: column;
    justify-content: space-between;
  }
  
  .menu-hamburguesa span {
    display: block;
    width: 100%;
    height: 3px;
    background-color: white;
    border-radius: 3px;
    transition: var(--transicion);
  }
  
  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    .menu-hamburguesa {
      display: flex;
    }
    
    .nav-list {
      position: fixed;
      top: 80px;
      left: 0;
      width: 100%;
      background-color: var(--color-fondo);
      flex-direction: column;
      padding: 2rem;
      transform: translateY(-100%);
      opacity: 0;
      visibility: hidden;
      transition: all 0.4s ease;
    }
    
    .nav-list.active {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
    }
    
    .header-container {
      padding: 0 1rem;
    }
  }
</style>

<script>
  // ===== DIAFRAGMA CANVAS (Código adaptado) =====
  document.addEventListener('DOMContentLoaded', function() {
    const canvas = document.getElementById('logoCanvas');
    if (!canvas) return;
    
    const ctx = canvas.getContext('2d');
    const W = canvas.width;
    const H = canvas.height;
    const cx = W / 2;
    const cy = H / 2;
    
    // Parámetros optimizados para 60px
    const BLADES = 9;
    const OUTER_R = 28;
    const INNER_OPEN = 20;
    const INNER_CLOSED = 0;
    const SLIDE = 22;
    
    let p = 0;
    let dir = 1;
    let lastTime = 0;
    const SPEED = 0.008;
    
    function drawBlade(angle, innerR, progress) {
      ctx.save();
      ctx.translate(cx, cy);
      ctx.rotate(angle);
      ctx.translate(0, -progress * SLIDE);
      
      ctx.beginPath();
      ctx.moveTo(innerR, -6);
      ctx.lineTo(OUTER_R, -14);
      ctx.lineTo(OUTER_R, 14);
      ctx.closePath();
      
      ctx.fillStyle = '#8A2BE2';
      ctx.fill();
      ctx.restore();
    }
    
    function clearCenter(r) {
      ctx.save();
      ctx.globalCompositeOperation = 'destination-out';
      ctx.beginPath();
      ctx.arc(cx, cy, r, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }
    
    function maskLens() {
      ctx.save();
      ctx.globalCompositeOperation = 'destination-in';
      ctx.beginPath();
      ctx.arc(cx, cy, OUTER_R, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }
    
    function animate(timestamp) {
      if (!lastTime) lastTime = timestamp;
      const delta = timestamp - lastTime;
      lastTime = timestamp;
      
      p += SPEED * dir * (delta / 16);
      if (p >= 1 || p <= 0) dir *= -1;
      
      ctx.clearRect(0, 0, W, H);
      
      const innerR = INNER_OPEN - p * (INNER_OPEN - INNER_CLOSED);
      for (let i = 0; i < BLADES; i++) {
        const angle = (Math.PI * 2 / BLADES) * i - 0.2;
        drawBlade(angle, innerR, p);
      }
      
      if (innerR > 0) clearCenter(innerR);
      maskLens();
      
      requestAnimationFrame(animate);
    }
    
    // Iniciar animación
    setTimeout(() => animate(0), 100);
    
    // ===== MENÚ HAMBURGUESA =====
    const menuToggle = document.getElementById('menuToggle');
    const navList = document.querySelector('.nav-list');
    
    if (menuToggle && navList) {
      menuToggle.addEventListener('click', function() {
        this.classList.toggle('active');
        navList.classList.toggle('active');
      });
      
      // Cerrar menú al hacer clic en enlace (móvil)
      document.querySelectorAll('.nav-link, .nav-btn-cliente').forEach(link => {
        link.addEventListener('click', () => {
          if (window.innerWidth <= 768) {
            menuToggle.classList.remove('active');
            navList.classList.remove('active');
          }
        });
      });
    }
    
    // ===== LOGO CLICK =====
    const logoLink = document.getElementById('logo-link');
    if (logoLink) {
      logoLink.addEventListener('click', function(e) {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  });
</script>
