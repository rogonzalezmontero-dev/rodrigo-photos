---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title="Rodrigo Montero | Fotógrafo" description="Fotografía de calle, eventos y retratos. Capturando momentos únicos, emociones y recuerdos." />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
		<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600&display=swap" rel="stylesheet">
	</head>

	<body>
		<Header />

		<main>
			<!-- PRESENTACIÓN CENTRADA -->
			<section class="presentacion-section">
				<div class="presentacion-container">
					<!-- Caja rectangular central -->
					<div class="caja-central">
						<!-- Texto completo centrado -->
						<div class="texto-completo">
							<p>
								Fotografiar es detener la luz antes de que se vuelva olvido.<br>
								En cada imagen busco gestos mínimos, esos que sostienen la memoria cuando los recuerdos comienzan a desvanecerse.<br>
								Mi mirada se posa en lo que ocurre una sola vez: instantes de vida que aún respiran, un rostro, un encuentro, una escena cotidiana que insiste en quedarse.<br>
								La cámara se vuelve entonces un viaje silencioso, donde la luz revela lo que el tiempo intenta borrar y cada fotografía guarda la forma íntima de un recuerdo.
							</p>
							
							<!-- Línea final en cursiva y gris claro -->
							<p class="frase-final">
								<em>Porque algunas imágenes no se miran: se recuerdan.</em>
							</p>
						</div>
						
						<!-- Firma -->
						<p class="firma">
							— Rodrigo
						</p>
					</div>
					
					<!-- Botones simples -->
					<div class="botones-container">
						<a href="#galeria" class="boton-ver">
							<i class="fas fa-images"></i> Ver Galería
						</a>
						<a href="#contacto" class="boton-contacto">
							<i class="fas fa-envelope"></i> Contactar
						</a>
					</div>
				</div>
			</section>
		</main>

		<Footer />
		
		<style>
			/* ===== RESET Y BASE ===== */
			body {
				background-color: #1B1B1B;
				color: #FFFFFF;
				font-family: 'Inter', sans-serif;
				line-height: 1.6;
				margin: 0;
				padding: 0;
				padding-top: 80px; /* Para el header fijo */
			}
			
			/* ===== SECCIÓN PRESENTACIÓN ===== */
			.presentacion-section {
				min-height: calc(100vh - 80px);
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 2rem 1.5rem;
			}
			
			.presentacion-container {
				max-width: 800px;
				width: 100%;
				text-align: center;
			}
			
			/* ===== TÍTULOS ===== */
			.titulo-principal {
				font-family: 'Space Grotesk', sans-serif;
				font-size: 2.8rem;
				font-weight: 300;
				color: #8A2BE2;
				margin-bottom: 2rem;
				letter-spacing: 3px;
				text-transform: uppercase;
			}
			
			/* ===== CAJA RECTANGULAR CENTRAL ===== */
			.caja-central {
				background: rgba(27, 27, 27, 0.9);
				border: 1px solid rgba(138, 43, 226, 0.3);
				border-radius: 12px;
				padding: 3rem 2.5rem;
				margin-bottom: 2.5rem;
				backdrop-filter: blur(10px);
				box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
			}
			
			/* ===== TEXTO COMPLETO CENTRADO ===== */
			.texto-completo {
				text-align: center;
				margin-bottom: 2rem;
			}
			
			.texto-completo p {
				font-family: 'Inter', sans-serif;
				font-size: 1.15rem;
				color: #E0E0E0;
				line-height: 1.9;
				margin-bottom: 1.8rem;
				font-weight: 350;
				letter-spacing: 0.3px;
			}
			
			.texto-completo br {
				display: block;
				margin: 0.8rem 0;
				content: "";
			}
			
			/* Frase final en cursiva y gris claro */
			.frase-final {
				font-family: 'Playfair Display', serif;
				font-size: 1.2rem;
				color: #B0B0B0 !important;
				font-style: italic;
				margin-top: 2rem;
				padding-top: 1.5rem;
				border-top: 1px solid rgba(255, 255, 255, 0.1);
				letter-spacing: 0.5px;
			}
			
			.frase-final em {
				font-style: italic;
				color: #B0B0B0;
			}
			
			/* ===== FIRMA ===== */
			.firma {
				font-family: 'Playfair Display', serif;
				font-size: 1.1rem;
				color: #8A2BE2;
				text-align: center;
				font-style: italic;
				margin-top: 1rem;
				padding-top: 1.5rem;
				border-top: 1px solid rgba(138, 43, 226, 0.3);
				letter-spacing: 1px;
			}
			
			/* ===== BOTONES ===== */
			.botones-container {
				display: flex;
				gap: 1.2rem;
				justify-content: center;
				flex-wrap: wrap;
			}
			
			.boton-ver, .boton-contacto {
				padding: 1rem 2.2rem;
				border-radius: 6px;
				font-weight: 500;
				text-decoration: none;
				display: inline-flex;
				align-items: center;
				gap: 10px;
				transition: all 0.3s ease;
				font-size: 1rem;
				border: 1px solid transparent;
				font-family: 'Space Grotesk', sans-serif;
				letter-spacing: 0.5px;
			}
			
			.boton-ver {
				background-color: #8A2BE2;
				color: white;
			}
			
			.boton-ver:hover {
				background-color: #7a1bd2;
				transform: translateY(-3px);
				box-shadow: 0 5px 15px rgba(138, 43, 226, 0.4);
			}
			
			.boton-contacto {
				background-color: transparent;
				color: #8A2BE2;
				border: 1px solid #8A2BE2;
			}
			
			.boton-contacto:hover {
				background-color: rgba(138, 43, 226, 0.1);
				transform: translateY(-3px);
				box-shadow: 0 5px 15px rgba(138, 43, 226, 0.2);
			}
			
			/* ===== RESPONSIVE ===== */
			@media (max-width: 768px) {
				.presentacion-section {
					padding: 1rem;
				}
				
				.titulo-principal {
					font-size: 2.2rem;
					letter-spacing: 2px;
					margin-bottom: 1.5rem;
				}
				
				.caja-central {
					padding: 2rem 1.5rem;
					border-radius: 10px;
				}
				
				.texto-completo p {
					font-size: 1.05rem;
					line-height: 1.8;
				}
				
				.frase-final {
					font-size: 1.1rem;
					margin-top: 1.5rem;
					padding-top: 1.2rem;
				}
				
				.botones-container {
					flex-direction: column;
					gap: 1rem;
				}
				
				.boton-ver, .boton-contacto {
					width: 100%;
					justify-content: center;
					padding: 0.9rem 2rem;
				}
			}
			
			/* Pequeños ajustes para móviles muy pequeños */
			@media (max-width: 480px) {
				.titulo-principal {
					font-size: 1.8rem;
				}
				
				.caja-central {
					padding: 1.5rem 1rem;
				}
				
				.texto-completo p {
					font-size: 1rem;
				}
				
				.frase-final {
					font-size: 1rem;
				}
				
				.firma {
					font-size: 1rem;
				}
			}
		</style>
	</body>
</html>
