---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title="Rodrigo Montero | Fotógrafo" description="Fotografía de calle, eventos y retratos. Capturando momentos únicos, emociones y recuerdos." />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
	</head>

	<body>
		<Header />

		<main>
			<!-- HERO SECTION - Presentación principal -->
			<section class="hero-section">
				<div class="hero-container">
					<!-- Texto principal -->
					<div class="hero-text">
						<h1 class="hero-title">
							<span class="hero-line">Capturar el mundo</span>
							<span class="hero-line">a través de la luz</span>
						</h1>
						
						<div class="hero-subtitle">
							Fotografía que narra historias • Emociones en cada frame
						</div>
						
						<!-- Caja de texto principal (tu nueva presentación) -->
						<div class="presentacion-box">
							<p class="presentacion-texto">
								<strong class="presentacion-destacado">Fotografiar es guardar el mundo en un suspiro de luz.</strong> 
								Es rescatar del olvido esos gestos mínimos que, como la distancia, 
								se llevan todo consigo.
							</p>
							
							<p class="presentacion-texto">
								Mi cámara no apunta a escenarios, sino a recuerdos que aún palpitan. 
								Busco en la mirada lo que las palabras callaron, en la calle las 
								historia que el tiempo no escribió.
							</p>
							
							<p class="presentacion-texto">
								Porque al final, lo único que queda son estos instantes robados al 
								olvido: pedazos de vida convertidos en memoria, en un viaje sin 
								retorno donde tú eres el único destino.
							</p>
							
							<p class="presentacion-firma">
								— Rodrigo Montero
							</p>
						</div>
						
						<!-- Llamadas a la acción -->
						<div class="hero-actions">
							<a href="#galeria" class="btn-primary">
								<i class="fas fa-images"></i> Ver Galería
							</a>
							<a href="#contacto" class="btn-secondary">
								<i class="fas fa-camera"></i> Trabajemos Juntos
							</a>
						</div>
					</div>
					
					<!-- Imagen de fondo/placeholder (luego será tu slider) -->
					<div class="hero-image">
						<div class="image-placeholder">
							<i class="fas fa-camera-retro"></i>
							<span>Tus fotografías aquí</span>
						</div>
					</div>
				</div>
			</section>
			
			<!-- Sección de enfoque (opcional, puedes quitarla si prefieres) -->
			<section class="enfoque-section">
				<div class="enfoque-container">
					<h2 class="enfoque-title">Mi Enfoque</h2>
					<div class="enfoque-palabras">
						<span class="palabra">Memoria</span>
						<span class="palabra">Recuerdos</span>
						<span class="palabra">Luz</span>
						<span class="palabra">Mirada</span>
						<span class="palabra">Gestos</span>
						<span class="palabra">Vida</span>
						<span class="palabra">Viaje</span>
						<span class="palabra">Distancia</span>
					</div>
					<p class="enfoque-texto">
						Cada proyecto es un diálogo entre lo visible y lo invisible. 
						Entre lo que la cámara captura y lo que el corazón guarda.
					</p>
				</div>
			</section>
		</main>

		<Footer />
		
		<style>
			/* ===== VARIABLES ===== */
			:root {
				--color-primario: #8A2BE2;
				--color-primario-suave: rgba(138, 43, 226, 0.1);
				--color-secundario: #1B1B1B;
				--color-texto: #E0E0E0;
				--color-texto-suave: #AAAAAA;
				--color-blanco: #FFFFFF;
				--espacio-lg: 4rem;
				--espacio-md: 2rem;
				--espacio-sm: 1rem;
				--radio: 12px;
				--transicion: all 0.3s ease;
			}
			
			/* ===== RESET ===== */
			body {
				background-color: var(--color-secundario);
				color: var(--color-texto);
				font-family: 'Inter', sans-serif;
				line-height: 1.6;
				margin: 0;
				padding: 0;
				padding-top: 80px; /* Para el header fijo */
			}
			
			/* ===== HERO SECTION ===== */
			.hero-section {
				padding: var(--espacio-lg) 0;
				min-height: 85vh;
				display: flex;
				align-items: center;
			}
			
			.hero-container {
				max-width: 1400px;
				margin: 0 auto;
				padding: 0 var(--espacio-md);
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: var(--espacio-lg);
				align-items: center;
			}
			
			.hero-text {
				display: flex;
				flex-direction: column;
				gap: var(--espacio-md);
			}
			
			.hero-title {
				font-family: 'Playfair Display', serif;
				font-size: 3.5rem;
				font-weight: 700;
				color: var(--color-blanco);
				line-height: 1.1;
				margin: 0;
			}
			
			.hero-line {
				display: block;
			}
			
			.hero-subtitle {
				font-size: 1.2rem;
				color: var(--color-primario);
				font-weight: 500;
				letter-spacing: 1px;
				text-transform: uppercase;
				margin-bottom: var(--espacio-sm);
			}
			
			/* ===== PRESENTACIÓN BOX ===== */
			.presentacion-box {
				background: rgba(27, 27, 27, 0.7);
				border-left: 4px solid var(--color-primario);
				padding: var(--espacio-md);
				border-radius: var(--radio);
				backdrop-filter: blur(10px);
				margin: var(--espacio-md) 0;
			}
			
			.presentacion-texto {
				font-size: 1.15rem;
				line-height: 1.8;
				color: var(--color-texto);
				margin-bottom: 1.5rem;
			}
			
			.presentacion-destacado {
				color: var(--color-blanco);
				font-weight: 600;
				font-size: 1.25rem;
			}
			
			.presentacion-firma {
				font-family: 'Playfair Display', serif;
				font-size: 1.1rem;
				color: var(--color-texto-suave);
				text-align: right;
				margin-top: var(--espacio-md);
				font-style: italic;
			}
			
			/* ===== BOTONES ===== */
			.hero-actions {
				display: flex;
				gap: var(--espacio-sm);
				flex-wrap: wrap;
				margin-top: var(--espacio-md);
			}
			
			.btn-primary, .btn-secondary {
				padding: 1rem 2rem;
				border-radius: 30px;
				font-weight: 600;
				text-decoration: none;
				display: inline-flex;
				align-items: center;
				gap: 10px;
				transition: var(--transicion);
				font-size: 1rem;
			}
			
			.btn-primary {
				background: linear-gradient(135deg, var(--color-primario), #6a11cb);
				color: var(--color-blanco);
				box-shadow: 0 4px 15px rgba(138, 43, 226, 0.3);
			}
			
			.btn-primary:hover {
				transform: translateY(-3px);
				box-shadow: 0 8px 25px rgba(138, 43, 226, 0.4);
			}
			
			.btn-secondary {
				background: transparent;
				color: var(--color-texto);
				border: 2px solid rgba(138, 43, 226, 0.3);
			}
			
			.btn-secondary:hover {
				border-color: var(--color-primario);
				color: var(--color-primario);
				background: var(--color-primario-suave);
			}
			
			/* ===== IMAGEN HERO (placeholder) ===== */
			.hero-image {
				display: flex;
				justify-content: center;
				align-items: center;
			}
			
			.image-placeholder {
				width: 100%;
				max-width: 500px;
				height: 400px;
				background: rgba(27, 27, 27, 0.5);
				border: 2px dashed rgba(138, 43, 226, 0.3);
				border-radius: var(--radio);
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
				color: var(--color-texto-suave);
				font-size: 1.1rem;
				gap: 1rem;
				transition: var(--transicion);
			}
			
			.image-placeholder:hover {
				border-color: var(--color-primario);
				color: var(--color-primario);
			}
			
			.image-placeholder i {
				font-size: 4rem;
				opacity: 0.5;
			}
			
			/* ===== SECCIÓN ENFOQUE ===== */
			.enfoque-section {
				padding: var(--espacio-lg) 0;
				background: rgba(0, 0, 0, 0.2);
				margin-top: var(--espacio-lg);
			}
			
			.enfoque-container {
				max-width: 800px;
				margin: 0 auto;
				padding: 0 var(--espacio-md);
				text-align: center;
			}
			
			.enfoque-title {
				font-family: 'Playfair Display', serif;
				font-size: 2.5rem;
				color: var(--color-blanco);
				margin-bottom: var(--espacio-md);
			}
			
			.enfoque-palabras {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 1rem;
				margin: var(--espacio-md) 0;
			}
			
			.palabra {
				padding: 0.8rem 1.5rem;
				background: var(--color-primario-suave);
				color: var(--color-primario);
				border-radius: 30px;
				font-weight: 500;
				transition: var(--transicion);
				border: 1px solid transparent;
			}
			
			.palabra:hover {
				background: rgba(138, 43, 226, 0.2);
				border-color: var(--color-primario);
				transform: translateY(-2px);
			}
			
			.enfoque-texto {
				font-size: 1.2rem;
				color: var(--color-texto-suave);
				max-width: 600px;
				margin: var(--espacio-md) auto 0;
				font-style: italic;
				line-height: 1.8;
			}
			
			/* ===== RESPONSIVE ===== */
			@media (max-width: 992px) {
				.hero-container {
					grid-template-columns: 1fr;
					gap: var(--espacio-md);
				}
				
				.hero-title {
					font-size: 2.8rem;
				}
				
				.hero-image {
					order: -1;
				}
				
				.image-placeholder {
					height: 300px;
				}
			}
			
			@media (max-width: 576px) {
				.hero-title {
					font-size: 2.2rem;
				}
				
				.presentacion-texto {
					font-size: 1.05rem;
				}
				
				.hero-actions {
					flex-direction: column;
				}
				
				.btn-primary, .btn-secondary {
					width: 100%;
					justify-content: center;
				}
				
				.enfoque-palabras {
					gap: 0.5rem;
				}
				
				.palabra {
					padding: 0.6rem 1.2rem;
					font-size: 0.9rem;
				}
			}
		</style>
	</body>
</html>
