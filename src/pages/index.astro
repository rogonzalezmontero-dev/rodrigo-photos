---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title="Rodrigo Montero" description="Fotografía" />
	</head>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet">
	<body>
		<Header />

		<main style="padding: 4rem 1.5rem; max-width: 900px; margin: auto;">
			<h1 style="font-size: 3rem; margin-bottom: 0.5rem;">
				Rodrigo Montero
			</h1>

			<p style="font-size: 1.2rem; opacity: 0.7; margin-bottom: 2rem;">
				Fotografía · eventos · retratos
			</p>

			<p style="font-size: 1.1rem; line-height: 1.6;">
				Fotografiar es una forma de viaje.  
				Un recorrido por el mundo, por los gestos mínimos, por la esencia de las personas
				y los lugares. Busco imágenes que hablen de vida, de memoria y de recuerdos que
				no se pueden repetir.
			</p>
		</main>

		<Footer />
<style>
  /* FONDO DE EMERGENCIA */
  body {
    background-color: #1B1B1B !important;
    color: white !important;
    margin: 0 !important;
    padding-top: 80px !important; /* Para el header fijo */
    font-family: 'Inter', sans-serif !important;
  }
  
  /* Asegurar que todo el texto sea blanco */
  h1, h2, h3, h4, h5, h6, p, span, a {
    color: white !important;
  }
</style>
	</body>
</html>
