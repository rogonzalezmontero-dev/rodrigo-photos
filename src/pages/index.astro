---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title="Rodrigo Montero | Fotógrafo" description="Fotografía de calle, eventos y retratos. Capturando momentos únicos, emociones y recuerdos." />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
	</head>

	<body>
		<Header />

		<main>
			<!-- PRESENTACIÓN CENTRADA -->
			<section class="presentacion-section">
				<div class="presentacion-container">
					<!-- Título simple -->
					<h1 class="titulo-principal">
						Fotografía
					</h1>
					
					<!-- Subtítulo -->
					<p class="subtitulo">
						Memoria · Recuerdos · Luz · Mirada · Gestos · Vida · Viaje
					</p>
					
					<!-- Caja rectangular central -->
					<div class="caja-central">
						<!-- Frase principal -->
						<p class="frase-destacada">
							<strong>Fotografiar es guardar el mundo en un suspiro de luz.</strong>
						</p>
						
						<!-- Texto completo -->
						<div class="texto-completo">
							<p>
								Es rescatar del olvido esos gestos mínimos que, como la distancia, 
								se llevan todo consigo.
							</p>
							
							<p>
								Mi cámara no apunta a escenarios, sino a recuerdos que aún palpitan. 
								Busco en la mirada lo que las palabras callaron, en la calle las 
								historias que el tiempo no escribió.
							</p>
							
							<p>
								Porque al final, lo único que queda son estos instantes robados al 
								olvido: pedazos de vida convertidos en memoria, en un viaje sin 
								retorno donde tú eres el único destino.
							</p>
						</div>
						
						<!-- Firma -->
						<p class="firma">
							— Rodrigo Montero
						</p>
					</div>
					
					<!-- Botones simples -->
					<div class="botones-container">
						<a href="#galeria" class="boton-ver">
							<i class="fas fa-images"></i> Ver Galería
						</a>
						<a href="#contacto" class="boton-contacto">
							<i class="fas fa-envelope"></i> Contactar
						</a>
					</div>
				</div>
			</section>
		</main>

		<Footer />
		
		<style>
			/* ===== RESET Y BASE ===== */
			body {
				background-color: #1B1B1B;
				color: #FFFFFF;
				font-family: 'Inter', sans-serif;
				line-height: 1.6;
				margin: 0;
				padding: 0;
				padding-top: 80px; /* Para el header fijo */
			}
			
			/* ===== SECCIÓN PRESENTACIÓN ===== */
			.presentacion-section {
				min-height: calc(100vh - 80px);
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 2rem 1.5rem;
			}
			
			.presentacion-container {
				max-width: 800px;
				width: 100%;
				text-align: center;
			}
			
			/* ===== TÍTULOS ===== */
			.titulo-principal {
				font-family: 'Playfair Display', serif;
				font-size: 2.5rem;
				font-weight: 400; /* Más delgado */
				color: #8A2BE2;
				margin-bottom: 0.5rem;
				letter-spacing: 1px;
			}
			
			.subtitulo {
				font-size: 1rem;
				color: #AAAAAA;
				font-weight: 300;
				letter-spacing: 2px;
				text-transform: uppercase;
				margin-bottom: 3rem;
			}
			
			/* ===== CAJA RECTANGULAR CENTRAL ===== */
			.caja-central {
				background: rgba(27, 27, 27, 0.8);
				border: 1px solid rgba(138, 43, 226, 0.2);
				border-radius: 8px;
				padding: 2.5rem;
				margin-bottom: 2.5rem;
				backdrop-filter: blur(5px);
			}
			
			.frase-destacada {
				font-size: 1.4rem;
				color: #FFFFFF;
				line-height: 1.5;
				margin-bottom: 2rem;
				padding-bottom: 1.5rem;
				border-bottom: 1px solid rgba(138, 43, 226, 0.3);
			}
			
			.frase-destacada strong {
				font-weight: 500;
				color: #8A2BE2;
			}
			
			.texto-completo {
				text-align: left;
				margin-bottom: 1.5rem;
			}
			
			.texto-completo p {
				font-size: 1.1rem;
				color: #E0E0E0;
				line-height: 1.8;
				margin-bottom: 1.5rem;
			}
			
			.firma {
				font-family: 'Playfair Display', serif;
				font-size: 1.1rem;
				color: #8A2BE2;
				text-align: right;
				font-style: italic;
				margin-top: 1rem;
				padding-top: 1rem;
				border-top: 1px solid rgba(138, 43, 226, 0.2);
			}
			
			/* ===== BOTONES ===== */
			.botones-container {
				display: flex;
				gap: 1rem;
				justify-content: center;
				flex-wrap: wrap;
			}
			
			.boton-ver, .boton-contacto {
				padding: 0.9rem 2rem;
				border-radius: 4px;
				font-weight: 500;
				text-decoration: none;
				display: inline-flex;
				align-items: center;
				gap: 10px;
				transition: all 0.3s ease;
				font-size: 0.95rem;
				border: 1px solid transparent;
			}
			
			.boton-ver {
				background-color: #8A2BE2;
				color: white;
			}
			
			.boton-ver:hover {
				background-color: #7a1bd2;
				transform: translateY(-2px);
			}
			
			.boton-contacto {
				background-color: transparent;
				color: #8A2BE2;
				border: 1px solid #8A2BE2;
			}
			
			.boton-contacto:hover {
				background-color: rgba(138, 43, 226, 0.1);
				transform: translateY(-2px);
			}
			
			/* ===== RESPONSIVE ===== */
			@media (max-width: 768px) {
				.presentacion-section {
					padding: 1rem;
				}
				
				.titulo-principal {
					font-size: 2rem;
				}
				
				.caja-central {
					padding: 1.5rem;
				}
				
				.frase-destacada {
					font-size: 1.2rem;
				}
				
				.texto-completo p {
					font-size: 1rem;
				}
				
				.botones-container {
					flex-direction: column;
				}
				
				.boton-ver, .boton-contacto {
					width: 100%;
					justify-content: center;
				}
			}
		</style>
	</body>
</html>
